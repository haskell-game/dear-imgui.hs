packages: *.cabal
package dear-imgui
  flags: +sdl +sdl-renderer +glfw +opengl2 +opengl3 +vulkan +examples
  ghc-options: -Wall -Wcompat -fno-warn-unused-do-bind

source-repository-package
    type: git
    location: https://github.com/expipiplus1/vulkan
    tag: 21cb4fcf55ba6c0bd37dcf2b645fb7e5ecdec23a
    subdir:
      utils
      utils-init/vulkan-init-glfw
      utils-init/vulkan-init-sdl2
